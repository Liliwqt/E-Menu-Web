# Copy to .env for local development. Never commit real credentials.
TOUCHORDERS_ENVIRONMENT=development
TOUCHORDERS_LOG_LEVEL=INFO
TOUCHORDERS_LOG_JSON=true

# Read only by llm.gateway — the sole OpenAI key holder.
# Never commit a populated .env file or add this value to Railway config-as-code.
OPENAI_API_KEY=

# Used ONLY for Firebase ID-token verification (verify_id_token).
# On Railway use the JSON content, not a local credentials path.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional for local development only; do not use this on Railway.
FIREBASE_CREDENTIALS_PATH=
