# Copy to .env for local development. Never commit real credentials.
TOUCHORDERS_ENVIRONMENT=development
TOUCHORDERS_LOG_LEVEL=INFO
TOUCHORDERS_LOG_JSON=true

# Read only by llm.gateway — the sole OpenAI key holder.
# Never commit a populated .env file or add this value to Railway config-as-code.
OPENAI_API_KEY=

# Used for Firebase ID-token verification and protected entitlement/AI-usage reads.
# On Railway use the JSON content, not a local credentials path.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Realtime Database URL for the same Firebase project as the portal.
FIREBASE_DATABASE_URL=
# Optional for local development only; do not use this on Railway.
FIREBASE_CREDENTIALS_PATH=

# Verified QR Ph (server only). Keep disabled until PayMongo provisions the
# platform for linked merchant accounts and each merchant is verified.
PAYMONGO_SECRET_KEY=
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_LINKED_ACCOUNTS_ENABLED=false

# Lifecycle adapters (optional at startup; unavailable exports fail visibly).
TOUCH_LIFECYCLE_GMAIL_APP_PASSWORD=
TOUCH_LIFECYCLE_BUCKET=
# Fernet key generated privately; keep old keys for the lifetime of their backups.
TOUCH_LIFECYCLE_ENCRYPTION_KEY=
# Leave false until the deletion manifest and isolated restore rehearsal are reviewed.
TOUCH_LIFECYCLE_DELETION_ENABLED=false
